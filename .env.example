# =============================================================================
# Joutiya — modèle de variables d'environnement
# Copier en `.env.local` (jamais commité) puis renseigner les valeurs.
# Toutes les ressources doivent pointer vers les projets dédiés « Joutiya »
# (jamais vers un projet existant d'un autre service).
#
# Préfixe NEXT_PUBLIC_ = exposé au navigateur. Ne JAMAIS y mettre un secret.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Joutiya
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret de signature des cookies de session / jetons CSRF (32+ octets aléatoires)
SESSION_SECRET=
CSRF_SECRET=

# --- Firebase (projet GCP dédié « joutiya ») -----------------------------------
# Config client (publique par conception, protégée par les règles Firestore + App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Admin SDK (serveur uniquement). Clé du compte de service encodée en base64.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# --- Cloudflare (compte / bucket dédiés « joutiya ») ---------------------------
CLOUDFLARE_ACCOUNT_ID=
# Jeton API à portée minimale (R2 + Images + Turnstile du seul projet Joutiya)
CLOUDFLARE_API_TOKEN=
# R2 (stockage des photos d'annonces)
R2_BUCKET_NAME=joutiya-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=
# Cloudflare Images (redimensionnement / variantes)
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Turnstile (anti-bot sur inscription, dépôt, messagerie)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting -----------------------------------------------------------
# Stockage des compteurs (ex. Upstash Redis / Cloudflare KV)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# --- RevenueCat (abonnements Pro, options payantes) --------------------------
REVENUECAT_PROJECT_ID=
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=

# --- Publicité (Google AdSense / Ad Manager) ----------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_SEARCH_FEED=
NEXT_PUBLIC_AD_SLOT_LISTING_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_TOP_BANNER=

# --- Hostinger (déploiement + e-mails transactionnels joutiya.ma) -------------
HOSTINGER_API_TOKEN=
HOSTINGER_MAIL_API_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Joutiya <no-reply@joutiya.ma>"
