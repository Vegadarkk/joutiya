# =============================================================================
# Joutiya — environment template
# Copy to `.env.local` (never committed) and fill in.
# Every value must point to the dedicated "Joutiya" projects, never to an existing project.
#
# NEXT_PUBLIC_ = exposed to the browser. NEVER put a secret there.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Joutiya
# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Session cookie / CSRF signing secrets (32+ random bytes)
SESSION_SECRET=
CSRF_SECRET=

# --- Firebase (dedicated GCP project "joutiya") ------------------------------
# Client config (public by design; protected by Firestore rules + App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Admin SDK (server only). Service account private key, base64-encoded.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# --- Cloudflare (dedicated "joutiya" resources) -------------------------------
CLOUDFLARE_ACCOUNT_ID=
# Least-privilege API token (Joutiya R2 + Images + Turnstile only)
CLOUDFLARE_API_TOKEN=
# R2 (listing photos)
R2_BUCKET_NAME=joutiya-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=
# Cloudflare Images (resizing / variants)
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Turnstile (anti-bot on signup, listing creation, messaging)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting -----------------------------------------------------------
# Counter store (e.g. Upstash Redis / Cloudflare KV)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# --- RevenueCat (Pro subscriptions, paid options) -----------------------------
REVENUECAT_PROJECT_ID=
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=

# --- Ads (Google AdSense / Ad Manager) ----------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_SEARCH_FEED=
NEXT_PUBLIC_AD_SLOT_LISTING_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_TOP_BANNER=

# --- Hostinger (deployment + transactional email for joutiya.ma) -------------
HOSTINGER_API_TOKEN=
HOSTINGER_MAIL_API_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Joutiya <no-reply@joutiya.ma>"
