# =============================================================================
# Joutiya — environment template (architecture v3)
# Copy to `.env.local` (never committed) and fill in; leave unused services empty.
# Every identifier must belong to the dedicated "Joutiya" resources recorded in
# infra/targets.json: scripts/assert-target.ts stops the app on any mismatch.
# Create each key only in the phase that uses it (docs/phase-0.md).
#
# NEXT_PUBLIC_ = exposed to the browser. NEVER put a secret there.
# Legal mentions live in Firestore config/legal (src/config/legal.ts), not here.
# =============================================================================

# --- Application -------------------------------------------------------------
# dev | staging | prod: selects the targets checked in infra/targets.json
APP_ENV=dev
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Joutiya
# Back-office host (admin.joutiya.ma in prod, admin-staging.joutiya.ma in staging); the proxy
# rewrites it to src/app/admin
ADMIN_HOST=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true: CSP sent as Content-Security-Policy-Report-Only (debugging only, never in prod)
CSP_REPORT_ONLY=
# Set by Docker Compose on the VM (image tag = commit SHA); "dev" locally
RELEASE=
# Local `node scripts/start-standalone.ts` only: server host (default localhost)
STANDALONE_HOST=
# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF HMAC secret and pepper for hashed identifiers (32+ random bytes each)
CSRF_SECRET=
HASH_PEPPER=

# --- Firebase (Spark projects, one per environment) --------------------------
# Client config: public by design, protected by Firestore rules (App Check is off)
NEXT_PUBLIC_FIREBASE_API_KEY=
# joutiya.ma behind the /__/auth/* relay outside local dev
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK: Workload Identity Federation (X.509) credential config file, no JSON key.
# Local dev uses the Auth and Firestore emulators.
GOOGLE_APPLICATION_CREDENTIALS=
# Google sign-in
GOOGLE_OAUTH_CLIENT_ID=

# --- Cloudflare (zone joutiya.ma) --------------------------------------------
CF_ACCOUNT_ID=
# Token for scripts/cloudflare.ts on the owner's machine only (never on the VM or in CI), limited
# to the Joutiya account and the joutiya.ma zone. Never the Global API Key. Prefixed name: Node's
# --env-file does not override a CLOUDFLARE_API_TOKEN of another project already in the shell.
JOUTIYA_CLOUDFLARE_API_TOKEN=
# Access applications (scripts/cloudflare.ts access): owner e-mail, service token IDs (not secrets)
ACCESS_OWNER_EMAIL=
ACCESS_CI_TOKEN_ID=
ACCESS_PROBE_TOKEN_ID=
# Tunnel token of this environment (stored on the VM only)
CLOUDFLARE_TUNNEL_TOKEN=
# Access (staff 2FA): <team>.cloudflareaccess.com and the application AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Turnstile widget of this environment
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- R2 storage (EU jurisdiction) --------------------------------------------
# https://<CF_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# S3 credentials of a token limited to this environment's buckets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=
R2_BUCKET_MEDIA=
R2_BUCKET_PRIVATE=
# Public media host, e.g. https://media.joutiya.ma
NEXT_PUBLIC_MEDIA_BASE_URL=
# Cloudflare Images is not used in the MVP: stays empty
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# --- Search: Meilisearch (internal Docker network) ---------------------------
MEILI_URL=
# Master key for administration only; separate keys for search (web) and indexing (worker)
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=
MEILI_INDEX_KEY=

# --- Valkey (internal Docker network, one password per instance) -------------
# valkey-ratelimit: allkeys-lru, no persistence
RATE_LIMIT_REDIS_URL=
# valkey-queue: BullMQ (noeviction, AOF) and quota counters
QUEUE_REDIS_URL=

# --- Payments (behind salesEnabled=false until the sales gate) ---------------
# Stripe account "Joutiya": restricted key, test mode outside prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# RevenueCat project "Joutiya" (sandbox outside prod)
REVENUECAT_PROJECT_ID=
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_KEY=
# Secret API key v2, minimal permissions (read customers)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_HMAC_SECRET=

# --- E-mail (sending domain notif.joutiya.ma) --------------------------------
# resend, later ses
MAIL_PROVIDER=resend
# Send-only key limited to the sending domain
MAIL_API_KEY=
# Signing secret of the bounce and complaint webhook
MAIL_WEBHOOK_SECRET=
# Brevo: overflow for security e-mails only
MAIL_FALLBACK_API_KEY=
MAIL_FROM="Joutiya <no-reply@notif.joutiya.ma>"
# Local tests only; production sends through the provider API, never SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp phone verification (inbound only: Joutiya never sends) ---------
# Meta test number in dev and staging, the dedicated number in prod
WHATSAPP_PHONE_NUMBER_ID=
# System user token limited to the number
WHATSAPP_ACCESS_TOKEN=
# App secret, verifies webhook signatures
WHATSAPP_APP_SECRET=
# Random string for the webhook subscription handshake
WHATSAPP_VERIFY_TOKEN=

# --- AI (moderation agent, Assistant Joutiya) --------------------------------
# One key per environment from the "Joutiya" Claude Console organization (5 USD/month cap)
ANTHROPIC_API_KEY=
# Free fallbacks: OpenAI moderation (project key, no prepaid credit), Workers AI (inference-only token)
OPENAI_API_KEY=
CF_WORKERS_AI_TOKEN=

# --- Alerts and observability ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail alerts go through the uptime Worker (workers/uptime-probe, POST /alert), signed with HMAC
ALERT_RELAY_URL=
ALERT_RELAY_SECRET=
# Sentry (EU region) or GlitchTip, chosen in phase 1
SENTRY_DSN=
# Origin of the error ingest, allowed by the CSP (connect-src)
ERROR_INGEST_ORIGIN=

# --- Backups -----------------------------------------------------------------
# age public key; the private key stays offline
BACKUP_AGE_RECIPIENT=

# --- Ads (AdSense, added after launch) ---------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_SEARCH_FEED=
NEXT_PUBLIC_AD_SLOT_LISTING_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_TOP_BANNER=

# --- Hostinger ---------------------------------------------------------------
# The site uses no Hostinger token: never in CI or on the VM (open point Z11).
