# =============================================================================
# Joutiya — environment template (architecture v3, phase 2)
# Copy to `.env.local` (never committed) and fill in; leave unused services empty.
# Every identifier must belong to the dedicated "Joutiya" resources recorded in
# infra/targets.json: scripts/assert-target.ts stops the app on any mismatch.
# Create each key only in the phase that uses it (docs/phase-0.md, docs/phase-2.md).
#
# There is NO NEXT_PUBLIC_* variable: one image serves staging and production, and the browser
# receives its configuration at runtime (/api/config, src/lib/config). A NEXT_PUBLIC_* name fails
# the build and the deployed startup. Public values (Firebase web config, Turnstile site key,
# Google client id, Sentry DSN) are still public by design; never a secret among them.
# Legal mentions live in Firestore config/legal (src/config/legal.ts), not here.
# =============================================================================

# --- Application -------------------------------------------------------------
# dev | staging | prod: selects the targets checked in infra/targets.json
APP_ENV=dev
NODE_ENV=development
# Public origin of this environment: https://joutiya.ma, https://staging.joutiya.ma
SITE_URL=http://localhost:3000
# Back-office host (admin.joutiya.ma in prod, admin-staging.joutiya.ma in staging); the proxy
# rewrites it to src/app/admin
ADMIN_HOST=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true: CSP sent as Content-Security-Policy-Report-Only, violations logged by /api/csp-report.
# Staging starts with true (§6); refused at startup in prod.
CSP_REPORT_ONLY=
# Set by Docker Compose on the VM (image tag = commit SHA); "dev" locally
RELEASE=
# Local `node scripts/start-standalone.ts` only: server host (default localhost)
STANDALONE_HOST=
# CSRF HMAC secret and pepper for hashed identifiers (32+ random characters each, distinct).
# On the VM, CSRF_SECRET is generated in place; HASH_PEPPER keys the hashed e-mails, phones and
# suppressions in Firestore and never changes: its staging and production copies are the owner's
# HASH_PEPPER_STAGING / HASH_PEPPER_PROD (`node scripts/vm-env.ts pepper .env.local`, docs/phase-1.md step 16).
CSRF_SECRET=
HASH_PEPPER=
# Development only: sent e-mails stay in memory, readable at /api/dev/mailbox (e2e tests)
DEV_MAILBOX=

# --- Firebase (Spark projects, one per environment) --------------------------
FIREBASE_PROJECT_ID=
# Browser key of the web app (public, referrer-restricted to the site's origins)
FIREBASE_API_KEY=
# Server calls to the Identity Toolkit REST API (password sign-in, action codes): a key without
# referrer restriction, API-restricted to Identity Toolkit; defaults to FIREBASE_API_KEY
FIREBASE_SERVER_API_KEY=
# 1:<project number>:web:<hash>; the project number is recorded in infra/targets.json
FIREBASE_APP_ID=
# Auth domain given to the browser SDK (custom tokens only); defaults to <project>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
# joutiya-web@<project>.iam.gserviceaccount.com: signs custom tokens through IAM (no key)
FIREBASE_SERVICE_ACCOUNT=
# Admin SDK: Workload Identity Federation (X.509) credential config file, no JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
# Same as FIREBASE_PROJECT_ID on the VM (scripts/vm-env.ts): spares google-auth-library a project lookup
GOOGLE_CLOUD_PROJECT=
# Local dev only (Auth and Firestore emulators, `npm run emulators`); refused outside dev
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# Google sign-in (Google Identity Services): OAuth web client <project number>-<hash>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# --- Cloudflare (zone joutiya.ma) --------------------------------------------
CF_ACCOUNT_ID=
# Token for scripts/cloudflare.ts on the owner's machine and in his global Claude cloud environment
# (never on the VM or in CI), limited to the Joutiya account and the joutiya.ma zone. Never the
# Global API Key. Prefixed name: Node's
# --env-file does not override a CLOUDFLARE_API_TOKEN of another project already in the shell.
JOUTIYA_CLOUDFLARE_API_TOKEN=
# Access applications (scripts/cloudflare.ts access): owner e-mail, service token IDs (not secrets)
ACCESS_OWNER_EMAIL=
ACCESS_CI_TOKEN_ID=
ACCESS_PROBE_TOKEN_ID=
# Tunnel tokens, owner's machine only (docs/phase-1.md step 2), checked by scripts/assert-target.ts.
# SSH goes into infra/vm/bootstrap.local.sh; prod and staging into /etc/joutiya/<env>/tunnel.env as
# TUNNEL_TOKEN (cloudflared's own variable; `node --env-file=<that file> scripts/assert-target.ts`
# checks it on the VM).
JOUTIYA_SSH_TUNNEL_TOKEN=
JOUTIYA_PROD_TUNNEL_TOKEN=
JOUTIYA_STAGING_TUNNEL_TOKEN=
# Cache purge token (zone joutiya.ma, Cache Purge only): /etc/joutiya/prod/deploy.env as CF_PURGE_TOKEN,
# next to CF_ZONE_ID. VM-only variables (TUNNEL_TOKEN, CF_ZONE_ID, CF_PURGE_TOKEN, VALKEY_PASSWORD)
# never go in this file.
JOUTIYA_CF_PURGE_TOKEN=
# Access (staff 2FA): <team>.cloudflareaccess.com and the application AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Turnstile widget of this environment (site key is public; dev may use Cloudflare's test pair)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- R2 storage (EU jurisdiction) --------------------------------------------
# The seven variables below go together (all set, or none): a partial set is refused at startup
# outside dev. Empty in dev: files live under <tmpdir>/joutiya-dev-storage, served by the signed
# dev-only route /api/dev/storage (src/lib/storage/fs.ts). Recommended (warning) in staging and prod
# until the bucket tokens exist; uploads answer 503 without them.
# https://<CF_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# S3 credentials of a token limited to this environment's buckets (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket names of this environment, as recorded in infra/targets.json (joutiya-<env>-<role>)
R2_BUCKET_QUARANTINE=
R2_BUCKET_MEDIA=
R2_BUCKET_PRIVATE=
# Public media host, https, e.g. https://media.joutiya.ma (dev defaults to the dev storage route)
MEDIA_BASE_URL=
# Bytes the other project of the shared Cloudflare account already stores in R2 (its 10 GB free
# quota is per account): added to our own byte count before the 8 GB alert. Default 4140000000.
R2_STORAGE_BASELINE_BYTES=
# Cloudflare Images is not used in the MVP: stays empty
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# --- Maps and media processing (phase 3) ------------------------------------
# Morocco PMTiles archive for the interactive map (https, e.g. https://media.joutiya.ma/maps/morocco.pmtiles);
# its origin enters the CSP. Empty: the listing page shows the static SVG map only.
MAP_PMTILES_URL=
# Worker only: directory of the local ONNX models (nudity, faces), fetched by scripts/fetch-models.ts
MEDIA_MODELS_DIR=

# --- Search: Meilisearch (internal Docker network) ---------------------------
MEILI_URL=
# Master key for administration only; separate keys for search (web) and indexing (worker)
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=
MEILI_INDEX_KEY=

# --- Valkey (internal Docker network, one password per instance) -------------
# valkey-ratelimit: allkeys-lru, no persistence
RATE_LIMIT_REDIS_URL=
# valkey-queue: BullMQ (noeviction, AOF), quota counters, WhatsApp verification codes
QUEUE_REDIS_URL=

# --- Payments (behind salesEnabled=false until the sales gate) ---------------
# Stripe account "Joutiya": restricted key, test mode outside prod (Pro subscriptions)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# RevenueCat project "Joutiya" (sandbox outside prod)
REVENUECAT_PROJECT_ID=
REVENUECAT_WEB_BILLING_KEY=
# Secret API key v2, minimal permissions (read customers and their purchases)
REVENUECAT_SECRET_API_KEY=
# Webhook: the static Authorization value set in the dashboard, and the HMAC signing secret
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_HMAC_SECRET=
# Public API key of the RevenueCat Stripe app (POST /v1/receipts of each Pro subscription)
REVENUECAT_STRIPE_PUBLIC_KEY=
# Web Purchase Link of the credit packs offering, https://pay.rev.cat/<token> (sandbox link outside prod)
REVENUECAT_PURCHASE_LINK=

# --- E-mail (sending domain notif.joutiya.ma) --------------------------------
# resend, later ses
MAIL_PROVIDER=resend
# Resend: sending-access key limited to the domain notif.joutiya.ma
MAIL_API_KEY=
# Signing secret (whsec_…) of the Resend bounce and complaint webhook (/api/webhooks/mail)
MAIL_WEBHOOK_SECRET=
# Brevo: fallback for security e-mails only
MAIL_FALLBACK_API_KEY=
MAIL_FROM="Joutiya <no-reply@notif.joutiya.ma>"

# --- WhatsApp phone verification (inbound only: Joutiya never sends) ---------
# WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET and WHATSAPP_DISPLAY_NUMBER go together, dev
# included (dummy values are fine): with any of the three missing, phone verification answers 503.
# Meta test number in dev and staging, the dedicated number in prod
WHATSAPP_PHONE_NUMBER_ID=
# App secret, verifies webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Random string for the webhook subscription handshake
WHATSAPP_VERIFY_TOKEN=
# Joutiya's WhatsApp number, international format, digits only (wa.me link), e.g. 212600000000
WHATSAPP_DISPLAY_NUMBER=

# --- AI (moderation agent, Assistant Joutiya; phase 5) -----------------------
# One key per environment from the "Joutiya" Claude Console organization (5 USD/month cap)
ANTHROPIC_API_KEY=
# Free fallbacks: OpenAI moderation (project key, no prepaid credit), Workers AI (inference-only token)
OPENAI_API_KEY=
CF_WORKERS_AI_TOKEN=

# --- Alerts and observability ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail alerts go through the uptime Worker (workers/uptime-probe, POST /alert), signed with HMAC
ALERT_RELAY_URL=
ALERT_RELAY_SECRET=
# Sentry free plan, EU region (DSN host *.ingest.de.sentry.io), chosen 2026-10-13. The DSN is
# public (the browser SDK receives it through /api/config); its ingest origin enters the CSP.
SENTRY_DSN=

# --- Backups -----------------------------------------------------------------
# age public key; the private key stays offline
BACKUP_AGE_RECIPIENT=

# --- Ads (AdSense, added after launch; served at runtime like the rest) -------
ADSENSE_CLIENT_ID=
AD_SLOT_SEARCH_FEED=
AD_SLOT_LISTING_SIDEBAR=
AD_SLOT_TOP_BANNER=

# --- Hostinger ---------------------------------------------------------------
# The site uses no Hostinger token: never in CI or on the VM. Z11 (2026-10-13): the owner revokes
# the old tokens once everything runs and creates the new ones outside the chat.
# Claude's own service access (JOUTIYA_HOSTINGER_MAIL_API_TOKEN for the mailboxes,
# JOUTIYA_OCI_* for Oracle) lives in the owner's Claude cloud environment, never in this file.
