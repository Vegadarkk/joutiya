{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.envrc)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*service-account*.json)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p)"
    ]
  }
}
