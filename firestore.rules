rules_version = '2';

// Every read and write goes through the Next.js API with the Admin SDK, which bypasses these
// rules (§3, §6). Browsers get nothing: no client query can be abused for injection or to burn
// the free quota. Phase 5 opens read access to a participant's own conversations (realtime
// messaging), and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
