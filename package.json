{
  "name": "joutiya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build && npm run build:node",
    "build:node": "node scripts/build-node.ts",
    "start": "next start",
    "worker": "node dist/worker/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-joutiya \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-joutiya \"playwright test\"",
    "assert-target": "node scripts/assert-target.ts",
    "check": "npm run lint && npm run typecheck && tsc -p workers/uptime-probe --noEmit && npm run test && node --test scripts/assert-target.test.ts",
    "test:api": "firebase emulators:exec --only auth,firestore --project demo-joutiya \"vitest run --config vitest.api.config.ts\"",
    "test:search": "vitest run --config vitest.search.config.ts",
    "test:e2e:only": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-joutiya",
    "create-admin": "node scripts/create-admin.ts",
    "dev:verify-phone": "node scripts/dev-verify-phone.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@protomaps/basemaps": "5.7.2",
    "@sentry/browser": "11.8.0",
    "@sentry/node": "11.8.0",
    "age-encryption": "0.3.1",
    "aws4fetch": "1.0.20",
    "blurhash": "2.0.5",
    "bullmq": "6.3.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase-admin": "14.5.0",
    "heic-to": "1.6.6",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.55.0",
    "mailchecker": "6.0.21",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "onnxruntime-node": "1.30.0",
    "pino": "10.4.0",
    "pmtiles": "4.5.0",
    "radix-ui": "1.8.1",
    "rate-limiter-flexible": "11.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/nft": "1.11.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
