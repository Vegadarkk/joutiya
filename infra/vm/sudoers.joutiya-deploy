# /etc/sudoers.d/joutiya-deploy (0440). The CI's deploy user is not in the docker group: its only
# privilege is this script, with its environment name as the only argument. Production has no
# deploy user: root runs the same script through OCI Run Command.
Defaults:deploy-staging env_keep += "SSH_ORIGINAL_COMMAND"
deploy-staging ALL=(root) NOPASSWD: /usr/local/sbin/joutiya-deploy staging
