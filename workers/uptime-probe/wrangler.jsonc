// Uptime probe and alert e-mail relay (architecture §2, Z5). Free plan: 1 of the 5 cron
// triggers, 10 ms CPU per run (waiting on fetch does not count), KV writes on state changes only.
// Deploy: see docs/phase-1.md (npx wrangler@4.144.0 deploy, from the owner's machine).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "joutiya-uptime-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // KV namespace "joutiya-uptime-state": its id is printed by `wrangler kv namespace create`.
  "kv_namespaces": [{ "binding": "STATE", "id": "6126e524b9a547bcb6d6ec6431316d2a" }],
  "vars": {
    // Alert e-mails leave through the Resend API (domain notif.joutiya.ma, phase 0 step 7), with a
    // key dedicated to this Worker. No Email Routing: @joutiya.ma mail lives at Hostinger.
    "ALERT_EMAIL_FROM": "Joutiya alertes <alertes@notif.joutiya.ma>",
    // Health endpoints probed every 5 minutes. Staging sits behind Access: service token headers.
    "PROBE_TARGETS": "[{\"name\":\"production\",\"url\":\"https://joutiya.ma/api/health\"},{\"name\":\"staging\",\"url\":\"https://staging.joutiya.ma/api/health\",\"access\":true}]"
  }
  // Secrets (wrangler secret put): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, ALERT_EMAIL_TO,
  // RESEND_API_KEY (sending access limited to notif.joutiya.ma; pipe it with `printf %s`, a trailing
  // newline breaks the Authorization header), ALERT_RELAY_SECRET, ACCESS_CLIENT_ID, ACCESS_CLIENT_SECRET.
  // ALERT_EMAIL_TO and RESEND_API_KEY go together: both unset turns e-mail off, one alone is an error.
}
